{
  "name": "Vaultr Design System",
  "version": "1.0.0",
  "description": "Design tokens for Vaultr wealth intelligence platform",
  "colors": {
    "primitive": {
      "gold": {
        "50": "#fdf8e8",
        "100": "#f9edbe",
        "200": "#f0d87a",
        "300": "#e5c34a",
        "400": "#d4af37",
        "500": "#c9a84c",
        "600": "#b8952e",
        "700": "#9a7b24",
        "800": "#7c631d",
        "900": "#5e4b16"
      },
      "dark": {
        "50": "#1a1a2e",
        "100": "#16162a",
        "200": "#121225",
        "300": "#0e0e1f",
        "400": "#0c0c1a",
        "500": "#0a0a0f",
        "600": "#08080c",
        "700": "#060609",
        "800": "#040406",
        "900": "#020203"
      },
      "white": {
        "5": "rgba(255,255,255,0.05)",
        "10": "rgba(255,255,255,0.10)",
        "20": "rgba(255,255,255,0.20)",
        "30": "rgba(255,255,255,0.30)",
        "40": "rgba(255,255,255,0.40)",
        "50": "rgba(255,255,255,0.50)",
        "60": "rgba(255,255,255,0.60)",
        "70": "rgba(255,255,255,0.70)",
        "80": "rgba(255,255,255,0.80)",
        "90": "rgba(255,255,255,0.90)"
      },
      "status": {
        "success": "#34d399",
        "warning": "#fbbf24",
        "error": "#f87171",
        "info": "#60a5fa"
      }
    },
    "semantic": {
      "background": {
        "primary": "{dark.500}",
        "secondary": "{dark.400}",
        "elevated": "{white.5}",
        "glass": "rgba(255,255,255,0.03)"
      },
      "text": {
        "primary": "{white.90}",
        "secondary": "{white.60}",
        "muted": "{white.40}",
        "disabled": "{white.20}",
        "accent": "{gold.500}"
      },
      "border": {
        "default": "{white.10}",
        "hover": "{white.20}",
        "focus": "rgba(201,168,76,0.5)",
        "accent": "rgba(201,168,76,0.2)"
      },
      "profit": "#34d399",
      "loss": "#f87171"
    }
  },
  "typography": {
    "fontFamily": {
      "sans": "Inter, system-ui, -apple-system, sans-serif",
      "mono": "JetBrains Mono, Fira Code, monospace"
    },
    "fontSize": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.125rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "3xl": "1.875rem",
      "4xl": "2.25rem"
    },
    "fontWeight": {
      "normal": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    }
  },
  "spacing": {
    "0": "0",
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.25rem",
    "6": "1.5rem",
    "8": "2rem",
    "10": "2.5rem",
    "12": "3rem",
    "16": "4rem",
    "20": "5rem",
    "24": "6rem"
  },
  "borderRadius": {
    "sm": "0.375rem",
    "md": "0.5rem",
    "lg": "0.75rem",
    "xl": "1rem",
    "2xl": "1.5rem",
    "full": "9999px"
  },
  "effects": {
    "glassmorphism": {
      "glass": {
        "background": "rgba(255,255,255,0.03)",
        "border": "1px solid rgba(255,255,255,0.08)",
        "backdropFilter": "blur(20px)",
        "borderRadius": "1rem"
      },
      "glassSubtle": {
        "background": "rgba(255,255,255,0.02)",
        "border": "1px solid rgba(255,255,255,0.05)",
        "backdropFilter": "blur(10px)",
        "borderRadius": "0.75rem"
      }
    },
    "shadows": {
      "glow": "0 0 20px rgba(201,168,76,0.15)",
      "glowStrong": "0 0 40px rgba(201,168,76,0.25)",
      "card": "0 4px 24px rgba(0,0,0,0.3)"
    },
    "animations": {
      "fadeInUp": "fadeInUp 0.5s ease-out forwards",
      "pulseRing": "pulseRing 2s ease-out infinite",
      "scroll": "scroll 30s linear infinite",
      "glowPulse": "glowPulse 3s ease-in-out infinite"
    }
  }
}
